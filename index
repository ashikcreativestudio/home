<style>
:root{
  --navy:#071a3f; --navy2:#0b2a6b; --blue:#1d5df0; --sky:#3fa9ff;
  --yellow:#ffd60a; --red:#e11d2e; --green:#16a34a; --wa:#25d366;
  --bg:#eef4ff; --card:#ffffff; --ink:#0d1b3a; --hd:#071a3f; --mut:#4a5b82; --line:#e1e9fb;
  --bn:'Hind Siliguri',sans-serif; --bn-head:'Anek Bangla',sans-serif; --en:'Poppins',sans-serif;
}
body.dark{--bg:#060e22;--card:#0e1b3d;--ink:#e6eeff;--hd:#ffffff;--mut:#a9bbe4;--line:#1c2f5e}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--bn);color:var(--ink);background:var(--bg);overflow-x:hidden;line-height:1.7;transition:background .4s,color .4s}
a{text-decoration:none;color:inherit}
button{font-family:inherit}
.en{font-family:var(--en)}
h1,h2,h3{font-family:var(--bn-head);line-height:1.25}
.container{width:min(1180px,92%);margin:auto}
.hide{display:none!important}

#progress{position:fixed;top:0;left:0;height:4px;width:0;background:linear-gradient(90deg,var(--yellow),var(--red),var(--blue));z-index:400}
#loader{position:fixed;inset:0;background:var(--navy);z-index:500;display:grid;place-items:center;transition:.6s}
#loader.off{opacity:0;visibility:hidden}
.ld{text-align:center;color:#fff;font-family:var(--bn-head);font-size:2rem;font-weight:800}
.ld span{color:var(--yellow)}
.ld i{display:block;width:180px;height:5px;background:#ffffff22;border-radius:5px;margin:14px auto 0;overflow:hidden}
.ld i::after{content:"";display:block;height:100%;width:40%;background:var(--yellow);border-radius:5px;animation:ldr 1s infinite}
@keyframes ldr{from{margin-left:-40%}to{margin-left:100%}}
#glow{position:fixed;width:340px;height:340px;border-radius:50%;pointer-events:none;background:radial-gradient(circle,#3fa9ff22,transparent 65%);transform:translate(-50%,-50%);z-index:1;display:none}
@media(hover:hover){#glow{display:block}}

/* header */
header{position:fixed;top:0;width:100%;z-index:300;transition:.35s}
header.scrolled{background:rgba(7,26,63,.93);backdrop-filter:blur(10px);box-shadow:0 6px 24px rgba(0,0,0,.25)}
.nav{display:flex;align-items:center;justify-content:space-between;padding:14px 0;gap:14px}
.logo{font-family:var(--bn-head);font-weight:800;font-size:1.5rem;color:#fff}
.logo span{color:var(--yellow)}
.menu{display:flex;gap:22px;align-items:center}
.menu a.lk{color:#e6eeff;font-weight:600;position:relative}
.menu a.lk::after{content:"";position:absolute;left:0;bottom:-4px;width:0;height:3px;background:var(--yellow);border-radius:3px;transition:.3s}
.menu a.lk:hover::after,.menu a.lk.act::after{width:100%}
.menu a.lk.act{color:var(--yellow)}
.tools{display:flex;gap:8px;align-items:center}
.tbtn{background:#ffffff1f;border:1px solid #ffffff33;color:#fff;border-radius:50px;padding:6px 14px;cursor:pointer;font-weight:700;font-size:.9rem;transition:.3s}
.tbtn:hover{background:var(--yellow);color:var(--navy)}
.btn-nav{background:var(--wa);color:#fff;padding:8px 18px;border-radius:50px;font-weight:700}
.burger{display:none;background:none;border:0;color:#fff;font-size:1.8rem;cursor:pointer}

/* hero */
.hero{position:relative;min-height:100vh;display:flex;align-items:center;color:#fff;overflow:hidden;
  background:radial-gradient(circle at 15% 20%,#1d5df0 0,transparent 40%),radial-gradient(circle at 85% 80%,#e11d2e55 0,transparent 40%),linear-gradient(135deg,#071a3f,#0b2a6b 60%,#071a3f)}
#particles{position:absolute;inset:0;z-index:0;width:100%;height:100%}
.hero .container{position:relative;z-index:2;display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center;padding:120px 0 70px}
.hs-wrap{display:grid}
.hs{grid-area:1/1;opacity:0;visibility:hidden;transform:translateX(40px);transition:.7s}
.hs.on{opacity:1;visibility:visible;transform:none}
.tag{display:inline-block;background:linear-gradient(90deg,var(--red),#ff5a36);padding:6px 20px;border-radius:8px;font-weight:700;transform:skew(-8deg);margin-bottom:16px;animation:pulse 2.4s infinite}
.hs h1{font-size:clamp(1.9rem,4.2vw,3.3rem);font-weight:800}
.hs h1 .name{display:block;font-size:clamp(2.6rem,6.2vw,4.8rem);background:linear-gradient(90deg,#fff,var(--sky),var(--yellow));-webkit-background-clip:text;background-clip:text;color:transparent;background-size:200% auto;animation:shine 5s linear infinite}
.hs h1 .y{color:var(--yellow)}
.role{font-size:1.2rem;margin:10px 0 4px;font-weight:600;color:#cfe0ff}
.typed{font-family:var(--en);font-weight:600;color:var(--yellow);font-size:1.15rem;min-height:2rem}
.typed::after{content:"|";animation:blink 1s infinite}
.lead{max-width:560px;margin:12px 0 24px;color:#dbe7ff;font-size:1.06rem}
.btns{display:flex;flex-wrap:wrap;gap:12px}
.btn{display:inline-flex;align-items:center;gap:10px;padding:13px 26px;border-radius:50px;font-weight:700;font-size:1.02rem;transition:.3s;cursor:pointer;border:0}
.btn-wa{background:var(--wa);color:#fff;box-shadow:0 10px 30px rgba(37,211,102,.45)}
.btn-yellow{background:var(--yellow);color:var(--navy)}
.btn-red{background:var(--red);color:#fff}
.btn-line{border:2px solid #fff;color:#fff;background:transparent}
.btn:hover{transform:translateY(-4px) scale(1.03)}
.hctrl{display:flex;align-items:center;gap:14px;margin-top:30px}
.arr{width:44px;height:44px;border-radius:50%;border:2px solid #ffffff55;background:#ffffff14;color:#fff;font-size:1.2rem;cursor:pointer;transition:.3s}
.arr:hover{background:var(--yellow);color:var(--navy);border-color:var(--yellow)}
.dots{display:flex;gap:8px}
.dots b{width:12px;height:12px;border-radius:12px;background:#ffffff44;cursor:pointer;transition:.4s}
.dots b.on{width:36px;background:var(--yellow)}
.hbar{height:4px;background:#ffffff22;border-radius:4px;margin-top:18px;max-width:300px;overflow:hidden}
.hbar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--yellow),var(--red))}
.pill-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.pill{background:#ffffff1c;border:1px solid #ffffff33;padding:5px 15px;border-radius:30px;font-size:.9rem;backdrop-filter:blur(6px)}
.photo-wrap{position:relative;display:flex;justify-content:center}
.ring{position:absolute;width:min(430px,86vw);aspect-ratio:1;border-radius:50%;background:conic-gradient(var(--yellow),var(--red),var(--blue),var(--sky),var(--yellow));animation:spin 8s linear infinite;filter:blur(2px)}
.photo{position:relative;width:min(390px,78vw);aspect-ratio:1;border-radius:50%;overflow:hidden;border:8px solid var(--navy);background:linear-gradient(135deg,var(--blue),var(--navy2));display:grid;place-items:center;margin:20px 0;animation:float 5s ease-in-out infinite}
.photo img{width:100%;height:100%;object-fit:cover;position:relative;z-index:2}
.photo .ph{position:absolute;font-family:var(--bn-head);font-size:7rem;font-weight:800;color:var(--yellow)}
.float-ic{position:absolute;width:62px;height:62px;border-radius:18px;display:grid;place-items:center;font-size:1.9rem;color:#fff;box-shadow:0 12px 28px rgba(0,0,0,.35);animation:float 4s ease-in-out infinite;z-index:3}
.i1{top:6%;left:2%;background:#1877f2}.i2{top:14%;right:0;background:#f00;animation-delay:.9s}
.i3{bottom:14%;left:0;background:linear-gradient(45deg,#f9ce34,#ee2a7b,#6228d7);animation-delay:1.4s}
.i4{bottom:6%;right:6%;background:var(--wa);animation-delay:.5s}

.marquee{background:var(--yellow);color:var(--navy);overflow:hidden;white-space:nowrap;padding:14px 0;font-weight:800;font-size:1.1rem;transform:rotate(-1deg);margin:-20px -10px 0;position:relative;z-index:5;box-shadow:0 8px 24px rgba(0,0,0,.2)}
.marquee div{display:inline-block;animation:scroll 28s linear infinite}
.marquee:hover div{animation-play-state:paused}
.marquee span{margin:0 26px}.marquee b{color:var(--red)}

section{padding:92px 0;position:relative}
.sec-head{text-align:center;margin-bottom:46px}
.sec-head small{display:inline-block;font-family:var(--en);font-weight:700;letter-spacing:2px;color:var(--blue);text-transform:uppercase;background:#1d5df01a;padding:5px 16px;border-radius:30px}
.sec-head h2{font-size:clamp(1.8rem,3.8vw,2.8rem);margin-top:14px;color:var(--hd)}
.sec-head h2 em{font-style:normal;color:var(--red)}
.sec-head p{max-width:620px;margin:10px auto 0;color:var(--mut)}

/* stats */
.stats{padding:60px 0;background:linear-gradient(90deg,var(--blue),var(--navy2));color:#fff}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;text-align:center}
.stat b{display:block;font-family:var(--en);font-size:3rem;font-weight:800;color:var(--yellow)}
.stat span{color:#dbe7ff;font-weight:600}

/* services */
.filters{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:18px}
.chip{padding:9px 22px;border-radius:50px;border:2px solid var(--line);background:var(--card);color:var(--hd);font-weight:700;cursor:pointer;transition:.3s}
.chip:hover{border-color:var(--blue)}
.chip.on{background:var(--blue);border-color:var(--blue);color:#fff;box-shadow:0 8px 20px #1d5df055}
.search{max-width:420px;margin:0 auto 34px;position:relative}
.search input{width:100%;padding:13px 20px 13px 46px;border-radius:50px;border:2px solid var(--line);background:var(--card);color:var(--ink);font-size:1rem;outline:none;font-family:var(--bn)}
.search input:focus{border-color:var(--blue)}
.search::before{content:"🔍";position:absolute;left:16px;top:50%;transform:translateY(-50%)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:24px}
.card{background:var(--card);border-radius:22px;padding:28px;position:relative;overflow:hidden;box-shadow:0 12px 36px rgba(11,42,107,.09);transition:transform .25s,box-shadow .4s;border:1px solid var(--line);transform-style:preserve-3d;will-change:transform}
.card::before{content:"";position:absolute;left:0;top:0;width:100%;height:6px;background:var(--c,var(--blue))}
.card:hover{box-shadow:0 24px 50px rgba(11,42,107,.22)}
.card .ic{width:62px;height:62px;border-radius:18px;display:grid;place-items:center;font-size:1.9rem;background:var(--c,var(--blue));margin-bottom:16px;transition:.6s}
.card:hover .ic{transform:rotate(360deg) scale(1.1)}
.card h3{font-size:1.3rem;color:var(--hd);margin-bottom:8px}
.card ul{list-style:none;margin-bottom:16px}
.card li{padding:4px 0 4px 26px;position:relative}
.card li::before{content:"✔";position:absolute;left:0;color:var(--green);font-weight:800}
.card .ord{background:var(--c,var(--blue));color:#fff;border:0;padding:9px 20px;border-radius:50px;font-weight:700;cursor:pointer;transition:.3s}
.card .ord:hover{transform:translateX(6px)}
.empty{text-align:center;color:var(--mut);padding:30px}

/* why */
.why{background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;overflow:hidden}
.why .sec-head h2{color:#fff}.why .sec-head p{color:#cfe0ff}
.why .sec-head small{background:#ffffff22;color:var(--yellow)}
.why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:20px}
.why-box{background:#ffffff12;border:1px solid #ffffff2a;border-radius:22px;padding:28px 20px;text-align:center;backdrop-filter:blur(8px);transition:.4s}
.why-box:hover{background:#ffffff22;transform:translateY(-8px)}
.why-box .ic{font-size:2.7rem;display:inline-block;animation:float 3.5s ease-in-out infinite}
.why-box h3{color:var(--yellow);font-size:1.25rem;margin:6px 0}
.why-box p{color:#d7e4ff;font-size:.96rem}

/* works carousel */
.car{position:relative}
.track{display:flex;gap:22px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:10px 4px 24px;cursor:grab}
.track::-webkit-scrollbar{display:none}
.track.drag{cursor:grabbing;scroll-snap-type:none}
.work{flex:0 0 min(340px,82%);scroll-snap-align:center;border-radius:22px;overflow:hidden;position:relative;aspect-ratio:4/5;background-size:cover;background-position:center;box-shadow:0 14px 34px rgba(11,42,107,.2);transition:.4s;color:#fff;display:flex;align-items:flex-end;user-select:none}
.work:hover{transform:translateY(-8px) scale(1.02)}
.work .cap{width:100%;padding:60px 20px 20px;background:linear-gradient(transparent,#000000cc)}
.work .cap small{font-family:var(--en);color:var(--yellow);font-weight:700;letter-spacing:1px}
.work .cap h3{font-size:1.3rem}
.work .big{position:absolute;top:18px;right:18px;font-size:2.4rem;opacity:.9}
.carbtn{position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:48px;height:48px;border-radius:50%;border:0;background:var(--yellow);color:var(--navy);font-size:1.3rem;cursor:pointer;box-shadow:0 8px 20px rgba(0,0,0,.3);transition:.3s}
.carbtn:hover{background:var(--red);color:#fff}
.carbtn.p{left:-14px}.carbtn.n{right:-14px}
.note{text-align:center;color:var(--mut);font-size:.92rem;margin-top:6px}

/* before after */
.ba{max-width:860px;margin:auto;position:relative;aspect-ratio:16/9;border-radius:24px;overflow:hidden;box-shadow:0 18px 44px rgba(11,42,107,.25);user-select:none}
.ba .l{position:absolute;inset:0;background-size:cover;background-position:center;display:grid;place-items:center;color:#fff;font-family:var(--bn-head);font-size:clamp(1.4rem,4vw,2.6rem);font-weight:800}
.ba .bef{background-image:url(ba-before.jpg),linear-gradient(135deg,#6b7280,#374151)}
.ba .aft{background-image:url(ba-after.jpg),linear-gradient(135deg,#1d5df0,#e11d2e,#ffd60a);clip-path:inset(0 0 0 50%)}
.ba .lab{position:absolute;top:14px;padding:5px 16px;border-radius:30px;background:#000000aa;color:#fff;font-weight:700;font-size:.9rem;z-index:3}
.ba .lab.a{left:14px}.ba .lab.b{right:14px;background:var(--red)}
.ba .hd{position:absolute;top:0;bottom:0;left:50%;width:4px;background:#fff;z-index:4;transform:translateX(-2px);pointer-events:none}
.ba .hd::after{content:"⇄";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:48px;height:48px;border-radius:50%;background:#fff;color:var(--blue);display:grid;place-items:center;font-size:1.4rem;font-weight:800;box-shadow:0 6px 18px rgba(0,0,0,.4)}
.ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;z-index:6}

/* video */
.vid{max-width:860px;margin:auto;aspect-ratio:16/9;border-radius:24px;overflow:hidden;box-shadow:0 18px 44px rgba(11,42,107,.25)}
.vid iframe{width:100%;height:100%;border:0}

/* process */
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:30px}
.step{background:var(--card);border-radius:22px;padding:34px 24px;text-align:center;position:relative;box-shadow:0 10px 30px rgba(11,42,107,.08);margin-top:14px;border:1px solid var(--line)}
.step .n{position:absolute;top:-22px;left:50%;transform:translateX(-50%);width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--red),#ff6a3d);color:#fff;font-family:var(--en);font-weight:800;display:grid;place-items:center;box-shadow:0 8px 18px rgba(225,29,46,.4)}
.step .ic{font-size:2.5rem}.step h3{margin:6px 0;color:var(--hd)}

/* testimonials */
.tst{max-width:760px;margin:auto;position:relative;text-align:center}
.tcard{display:none;background:var(--card);padding:36px;border-radius:24px;box-shadow:0 14px 36px rgba(11,42,107,.12);border:1px solid var(--line)}
.tcard.on{display:block;animation:fade .6s}
.tcard p{font-size:1.15rem;margin-bottom:14px}.tcard b{color:var(--hd)}
.tcard .st{color:var(--yellow);font-size:1.3rem;letter-spacing:3px}
.tctl{display:flex;justify-content:center;gap:12px;margin-top:20px}
.tctl .arr{border-color:var(--blue);color:var(--blue);background:transparent}
.tctl .arr:hover{color:var(--navy)}

/* faq */
.faq{max-width:800px;margin:auto}
.fq{background:var(--card);border-radius:18px;margin-bottom:14px;border:1px solid var(--line);overflow:hidden}
.fq button{width:100%;text-align:left;background:none;border:0;padding:18px 22px;font-size:1.08rem;font-weight:700;color:var(--hd);cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px}
.fq button::after{content:"+";font-size:1.6rem;color:var(--red);transition:.3s}
.fq.open button::after{transform:rotate(45deg)}
.fq .a{max-height:0;overflow:hidden;transition:max-height .4s;padding:0 22px;color:var(--mut)}
.fq.open .a{max-height:200px;padding-bottom:18px}

/* contact */
.contact{background:linear-gradient(135deg,#0b2a6b,#071a3f)}
.contact-wrap{display:grid;grid-template-columns:1fr 1fr;gap:30px}
.c-info,.c-form{border-radius:26px;padding:34px}
.c-info{background:linear-gradient(160deg,var(--yellow),#ffb703);color:var(--navy)}
.c-info h2{font-size:2rem}
.c-line{display:flex;gap:14px;align-items:center;background:#ffffffd9;border-radius:16px;padding:12px 16px;margin-top:14px;font-weight:700;transition:.3s;color:var(--navy);position:relative}
.c-line:hover{transform:translateX(8px)}
.c-line .ic{font-size:1.6rem}.c-line .en{word-break:break-all}
.cp{margin-left:auto;background:var(--navy);color:#fff;border:0;border-radius:30px;padding:5px 14px;font-weight:700;cursor:pointer;font-size:.85rem}
.qr{display:flex;align-items:center;gap:14px;margin-top:16px;background:#ffffffd9;border-radius:16px;padding:12px 16px;font-weight:700}
.qr img{width:92px;height:92px;border-radius:10px;background:#fff}
.c-form{background:var(--card)}
.c-form h3{color:var(--hd);font-size:1.5rem;margin-bottom:14px}
.c-form input,.c-form select,.c-form textarea{width:100%;padding:13px 16px;margin-bottom:12px;border:2px solid var(--line);border-radius:14px;font-family:var(--bn);font-size:1rem;outline:none;transition:.3s;background:var(--card);color:var(--ink)}
.c-form input:focus,.c-form select:focus,.c-form textarea:focus{border-color:var(--blue);box-shadow:0 0 0 4px #1d5df01f}
.c-form .btn{width:100%;justify-content:center}
.err{border-color:var(--red)!important}
.cnt{text-align:right;font-size:.8rem;color:var(--mut);margin:-8px 0 8px}

footer{background:#04112b;color:#b9c8ea;text-align:center;padding:34px 0}
footer b{color:var(--yellow)}
footer .soc{display:flex;gap:12px;justify-content:center;margin-bottom:12px}
footer .soc a{width:42px;height:42px;border-radius:50%;background:#ffffff14;display:grid;place-items:center;transition:.3s}
footer .soc a:hover{background:var(--yellow);transform:translateY(-4px)}

/* floating */
.dial{position:fixed;right:18px;bottom:20px;z-index:250;display:flex;flex-direction:column-reverse;align-items:center;gap:12px}
.dial .main{width:62px;height:62px;border-radius:50%;background:var(--wa);border:0;color:#fff;font-size:1.8rem;cursor:pointer;animation:ring 2s infinite;transition:.3s}
.dial.open .main{transform:rotate(135deg);background:var(--red);animation:none}
